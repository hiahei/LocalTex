<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:TPM="http://texlive.dante.de/"><rdf:Description about="http://www.miktex.org/packages/newfloat"><TPM:Name>newfloat</TPM:Name><TPM:Creator>mpc</TPM:Creator><TPM:Title>Define new floating environments</TPM:Title><TPM:Version>1.2</TPM:Version><TPM:TargetSystem minVersion=""></TPM:TargetSystem><TPM:Description>The package offers the command \DeclareFloatingEnvironment, which the user may use to define new floating environments which behave like the LaTeX standard foating environments figure and table.</TPM:Description><TPM:RunFiles size="82517">texmf\tex\latex\newfloat\newfloat_v1.0.sty texmf\tex\latex\newfloat\newfloat.sty texmf\tex\latex\newfloat\newfloat_v1.1.sty</TPM:RunFiles><TPM:TimePackaged>1696340584</TPM:TimePackaged><TPM:MD5>834a4f73053d7c99b408086eed29c762</TPM:MD5><TPM:CTAN path="/macros/latex/contrib/newfloat"/><TPM:Copyright owner="Axel Sommerfeldt" year="2011-2023"/><TPM:License type="lppl1.3"/></rdf:Description></rdf:RDF>